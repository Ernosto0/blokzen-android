    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.0",
    "vite": "^7.3.7"
  },
  "type": "module"
}
